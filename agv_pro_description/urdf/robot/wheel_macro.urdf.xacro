<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wheel" params="side wheel_radius">
    <!-- 轮子几何参数 -->
    <xacro:property name="wheel_separation_x" value="0.3431" />
    <xacro:property name="wheel_separation_y" value="0.312" />
    <xacro:property name="wheel_thickness" value="0.033" />
    <xacro:property name="mass" value="1" />
    
    <xacro:property name="ixx" value="0.00052475" />
    <xacro:property name="iyy" value="0.00099948" />
    <xacro:property name="izz" value="0.00052362" />

    <!-- 根据side参数设置轮子位置、mesh文件和惯性参数 -->
    <!-- 前左轮 -->
    <xacro:if value="${side == 'lf'}">
      <xacro:property name="x" value="${wheel_separation_x/2.0}" />
      <xacro:property name="y" value="${wheel_separation_y/2.0}" />
      <xacro:property name="mesh" value="file://$(find agv_pro_description)/meshes/wheel_lf_link.stl" />
      <xacro:property name="visual_rotation" value="${pi}" />
      <xacro:property name="fdir" value="1.0 1.0 0.0" />
    </xacro:if>
    
    <!-- 前右轮 -->
    <xacro:if value="${side == 'rf'}">
      <xacro:property name="x" value="${wheel_separation_x/2.0}" />
      <xacro:property name="y" value="${-wheel_separation_y/2.0}" />
      <xacro:property name="mesh" value="file://$(find agv_pro_description)/meshes/wheel_rf_link.stl" />
      <xacro:property name="visual_rotation" value="${pi}" />
      <xacro:property name="fdir" value="1.0 -1.0 0.0" />
    </xacro:if>
         
    <!-- 后左轮 -->
    <xacro:if value="${side == 'lb'}">
      <xacro:property name="x" value="${-wheel_separation_x/2.0}" />
      <xacro:property name="y" value="${wheel_separation_y/2.0}" />
      <xacro:property name="mesh" value="file://$(find agv_pro_description)/meshes/wheel_lb_link.stl" />
      <xacro:property name="visual_rotation" value="${0.0}" />
      <xacro:property name="fdir" value="1.0 -1.0 0.0" />
    </xacro:if>
         
    <!-- 后右轮 -->
    <xacro:if value="${side == 'rb'}">
      <xacro:property name="x" value="${-wheel_separation_x/2.0}" />
      <xacro:property name="y" value="${-wheel_separation_y/2.0}" />
      <xacro:property name="mesh" value="file://$(find agv_pro_description)/meshes/wheel_rb_link.stl" />
      <xacro:property name="visual_rotation" value="${0.0}" />
      <xacro:property name="fdir" value="1.0 1.0 0.0" />
    </xacro:if>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${side}_wheel_link" />
      <origin xyz="${x} ${y} 0.03" rpy="0.0 0.0 0.0" />
      <axis xyz="0.0 1.0 0.0" />
      <limit effort="1.5" velocity="24.0" />
      <dynamics damping="0.001" friction="0.001" />
    </joint>

    <link name="${side}_wheel_link">
      <visual>
        <geometry>
          <mesh filename="${mesh}" />
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${visual_rotation}" />
        <material name="">
          <color rgba="0 0 0 1" />
        </material>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}" />
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0" />
      </collision>

      <inertial>
        <mass value="${mass}" />
        <inertia ixx="${ixx}" ixy="0.0"    ixz="0.0"
                              iyy="${iyy}" iyz="0.0"
                                           izz="${izz}" />
      </inertial>
    </link>

    <gazebo reference="${side}_wheel_link" xmlns:ignition="http://ignitionrobotics.org/schema">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.2</mu2>
                <slip1>0.035</slip1>
              <slip2>0</slip2>
              <fdir1 ignition:expressed_in="base_footprint">${fdir}</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>

  </xacro:macro>
</robot>